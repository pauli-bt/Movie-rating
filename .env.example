# Postgres connection string from Neon (use the pooled "DATABASE_URL" and direct "DIRECT_URL")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ethiopiaimdb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/ethiopiaimdb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional for V1 — leave blank to hide the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (for poster/photo uploads — optional in V1, seed script uses plain URLs)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
